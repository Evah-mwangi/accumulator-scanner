<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Mobile Stable Accumulator Scanner v2</title>
  <!-- Keeping all original styles -->
  <style>
    body { background-color: #0b0f19; color: #ffffff; font-family: sans-serif; padding: 10px; max-width: 500px; margin: 0 auto; font-size: 14px;}
    .card { background: #131a29; border-radius: 8px; padding: 12px; margin-bottom: 8px; border: 1px solid #1e293b;}
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    input, select { width: 100%; padding: 8px; background: #1e293b; color: #fff; border: 1px solid #334155; border-radius: 4px; box-sizing: border-box; font-size: 14px;}
    .btn-group { display: flex; gap: 4px; margin-top: 8px;}
    .btn-group button { flex: 1; padding: 8px; background: #1e293b; color: #fff; border: 1px solid #334155; border-radius: 4px; cursor: pointer; font-size: 12px;}
    .btn-group button.active { background: #00b8d9; color: #000; font-weight: bold; border-color: #00b8d9;}
    .val-large { font-size: 1.4rem; font-weight: bold; margin: 2px 0; min-height: 1.6rem;}
    .subtext { font-size: 0.7rem; color: #94a3b8; line-height: 1.2;}
    .path-row { display: flex; justify-content: space-between; text-align: center; gap: 2px;}
    .path-box { background: #1e293b; padding: 6px; border-radius: 4px; flex: 1; font-size: 12px;}
    .status-badge { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; margin-right: 4px; }
    .status-badge.connected { background: #22c55e; }
    label { font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; font-weight: bold;}
    #stability-bar-container { width: 100%; height: 4px; background: #334155; border-radius: 2px; margin-top: 4px; overflow: hidden;}
    #stability-bar-fill { height: 100%; width: 0%; background: #4ade80; transition: width 0.3s ease, background-color 0.3s ease;}
  </style>
</head>
<body>

  <div class="card" style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px;">
    <div><b style="font-size: 1rem;">ACCUMULATOR SCANNER</b></div>
    <div style="font-size: 0.75rem; display: flex; align-items: center; background: #1e293b; padding: 4px 8px; border-radius: 12px;">
      <span id="status-dot" class="status-badge"></span>
      <span id="status-text">Connecting...</span>
    </div>
  </div>

  <div class="card">
    <label>MARKET</label>
    <select id="market" onchange="switchMarket()">
      <option value="R_10">Volatility 10 Index</option>
      <option value="R_25">Volatility 25 Index</option>
      <option value="R_50">Volatility 50 Index</option>
      <option value="R_75" selected>Volatility 75 Index (Fallback Test)</option>
      <option value="R_100">Volatility 100 Index</option>
    </select>
  </div>

  <div class="card grid-2">
    <div>
      <label>STAKE (USD)</label>
      <input type="number" id="stake" value="1" oninput="calculate()">
    </div>
    <div>
      <label>TAKE PROFIT (ticks)</label>
      <input type="number" id="ticks" value="25" oninput="calculate()">
    </div>
  </div>

  <div class="card">
    <label>GROWTH PER TICK</label>
    <div class="btn-group" id="growth-group">
      <button onclick="setGrowth(0.01, this)">1%</button>
      <button onclick="setGrowth(0.02, this)">2%</button>
      <button onclick="setGrowth(0.03, this)" class="active">3%</button>
      <button onclick="setGrowth(0.04, this)">4%</button>
      <button onclick="setGrowth(0.05, this)">5%</button>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="subtext">LATEST SPOT</div>
      <div class="val-large" id="spot-val">--.--</div>
      <div class="subtext" id="tick-count">Waiting for data...</div>
    </div>
    <div class="card">
      <div class="subtext">RECENT STABILITY</div>
      <div class="val-large" id="stability-val">--/100</div>
      <div class="subtext">Descriptive, not predictive</div>
      <div id="stability-bar-container"><div id="stability-bar-fill"></div></div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="subtext">PLANNED VALUE</div>
      <div class="val-large" id="planned-val">1.00</div>
      <div class="subtext">Projection after TP ticks</div>
    </div>
    <div class="card">
      <div class="subtext">PROJECTED GAIN</div>
      <div class="val-large" style="color: #4ade80;" id="gain-val">+0.00</div>
      <div class="subtext">Before pricing effects</div>
    </div>
  </div>

  <div class="card">
    <div class="subtext" style="margin-bottom: 6px;">Compounding path (based on current growth)</div>
    <div class="path-row">
      <div class="path-box"><div class="subtext">0t</div><b id="p0">1.00</b></div>
      <div class="path-box"><div class="subtext">5t</div><b id="p5">1.16</b></div>
      <div class="path-box"><div class="subtext">10t</div><b id="p10">1.34</b></div>
      <div class="path-box"><div class="subtext">25t</div><b id="p25">2.09</b></div>
      <div class="path-box"><div class="subtext">50t</div><b id="p50">4.38</b></div>
    </div>
  </div>

  <script>
    let currentGrowth = 0.03;
    let ws = null;
    let tickHistory = [];
    const MAX_TICKS = 100;
    // CRUCIAL MOBILE FIX: Changed APP_ID to a fallback public one
    const APP_ID = 1089;
    let isConnected = false;
    let retryTimeout;
    let subscribeDelay;

    function connectWS() {
      if (ws) {
        ws.onopen = ws.onmessage = ws.onclose = null;
        if (ws.readyState === WebSocket.OPEN) ws.close();
      }

      setStatus('Connecting...', 'connecting');
      
      try {
        ws = new WebSocket(`wss://ws.binaryws.com/websockets/v3?app_id=${APP_ID}`);
      } catch (e) {
        console.error("WS connection error:", e);
        reconnectDelayed();
        return;
      }

      ws.onopen = () => {
        isConnected = true;
        setStatus('LIVE ENGINE', 'connected');
        console.log("WS Connected");
        // CRUCIAL MOBILE FIX: Wait 1 full second before subscribing
        clearTimeout(subscribeDelay);
        subscribeDelay = setTimeout(subscribeToMarket, 1000); 
      };

      ws.onmessage = (event) => {
        let data;
        try {
          data = JSON.parse(event.data);
        } catch (e) {
          console.error("Failed to parse JSON", event.data);
          return;
        }

        if (data.error) {
          console.error("API Error:", data.error.message);
          setStatus('API Error', 'error');
          // Auto-reconnect on API error after a delay
          reconnectDelayed();
          return;
        }

        if (data.msg_type === 'tick' && data.tick) {
          // CRUCIAL MOBILE FIX: Advanced data structure safety check
          if (!data.tick || typeof data.tick.quote === 'undefined') {
            return;
          }
          
          const price = parseFloat(data.tick.quote);
          if (isNaN(price)) return;

          document.getElementById('spot-val').innerText = price.toFixed(3);
          
          tickHistory.push(price);
          if (tickHistory.length > MAX_TICKS) {
            tickHistory.shift();
          }

          const count = tickHistory.length;
          document.getElementById('tick-count').innerText = `${count} tick${count === 1 ? '' : 's'} loaded`;
          if (count === MAX_TICKS) document.getElementById('tick-count').innerText = `Buffer Full (${MAX_TICKS})`;

          if (count >= 2) calculateStability();
        }
      };

      ws.onclose = (event) => {
        isConnected = false;
        setStatus('Offline', 'error');
        console.log("WS Closed:", event.reason);
        reconnectDelayed(); 
      };

      ws.onerror = (error) => {
        console.error("WS Error:", error);
      };
    }

    function subscribeToMarket() {
      if (!ws || ws.readyState !== WebSocket.OPEN) return;
      
      tickHistory = [];
      document.getElementById('spot-val').innerText = '--.--';
      document.getElementById('tick-count').innerText = 'Subscribing...';
      document.getElementById('stability-val').innerText = '--/100';
      updateStabilityBar(0);

      const marketSymbol = document.getElementById('market').value;
      
      console.log(`Gentle Subscribe to: ${marketSymbol}`);
      ws.send(JSON.stringify({
        ticks: marketSymbol,
        subscribe: 1
      }));
    }

    function switchMarket() {
      // Full reconnect is still safest on mobile for market switching
      console.log("Market switch, forced reconnect.");
      reconnectDelayed(500); // Fast retry
    }
    
    function reconnectDelayed(delay = 5000) {
      clearTimeout(retryTimeout);
      setStatus('Waiting Retry...', 'connecting');
      if (ws) ws.close(); // Triggers the onclose loop if needed, else redundant safety
      retryTimeout = setTimeout(connectWS, delay);
    }

    function setStatus(text, type) {
      const dot = document.getElementById('status-dot');
      const txt = document.getElementById('status-text');
      txt.innerText = text;
      dot.className = 'status-badge';
      if (type === 'connected') dot.classList.add('connected');
      if (type === 'error') dot.style.backgroundColor = '#ef4444';
      if (type === 'connecting') dot.style.backgroundColor = '#facc15';
    }

    function calculateStability() {
      if (tickHistory.length < 10) {
          document.getElementById('stability-val').innerText = 'Calc...';
          return;
      }

      let totalPctVariance = 0;
      for (let i = 1; i < tickHistory.length; i++) {
        const change = Math.abs(tickHistory[i] - tickHistory[i - 1]);
        const pctChange = (change / tickHistory[i - 1]) * 100;
        totalPctVariance += pctChange;
      }

      const avgPctVariance = totalPctVariance / (tickHistory.length - 1);
      
      const stabilityMultiplier = 5000; 
      let score = Math.round(100 - (avgPctVariance * stabilityMultiplier));
      score = Math.max(1, Math.min(100, score)); 

      updateStabilityDisplay(score);
    }

    function updateStabilityDisplay(score) {
      const stabilityElem = document.getElementById('stability-val');
      stabilityElem.innerText = `${score}/100`;
      
      let color = '#4ade80';
      if (score < 70) color = '#facc15';
      if (score < 40) color = '#f87171';
      
      stabilityElem.style.color = color;
      updateStabilityBar(score, color);
    }
    
    function updateStabilityBar(score, color) {
        const barFill = document.getElementById('stability-bar-fill');
        if (!barFill) return;
        barFill.style.width = `${score}%`;
        barFill.style.backgroundColor = color || '#4ade80';
    }

    function setGrowth(rate, btn) {
      currentGrowth = rate;
      document.querySelectorAll('#growth-group button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      calculate();
    }

    function calculate() {
      const stakeInput = document.getElementById('stake');
      const ticksInput = document.getElementById('ticks');
      if (!stakeInput || !ticksInput) return;

      const stake = parseFloat(stakeInput.value) || 1;
      const ticks = parseInt(ticksInput.value) || 25;

      const plannedVal = stake * Math.pow(1 + currentGrowth, ticks);
      const gainVal = plannedVal - stake;

      const plannedElem = document.getElementById('planned-val');
      const gainElem = document.getElementById('gain-val');
      if (plannedElem) plannedElem.innerText = plannedVal.toFixed(2);
      if (gainElem) {
        gainElem.innerText = (gainVal >= 0 ? "+" : "") + gainVal.toFixed(2);
        gainElem.style.color = gainVal >= 0 ? '#4ade80' : '#f87171';
      }

      const pathTicks = [0, 5, 10, 25, 50];
      pathTicks.forEach(t => {
          const val = stake * Math.pow(1 + currentGrowth, t);
          const elem = document.getElementById(`p${t}`);
          if (elem) elem.innerText = val.toFixed(2);
      });
    }

    calculate();
    updateStabilityBar(0);
    connectWS();

  </script>
</body>
</html>
